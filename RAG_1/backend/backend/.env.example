# Copy to .env and fill in. NEVER commit .env
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# Qdrant: local embedded mode (no server) or a server
USE_LOCAL_QDRANT=true
QDRANT_LOCAL_PATH=./qdrant_db
# QDRANT_HOST=localhost
# QDRANT_PORT=6333

# Reranker: bge-reranker-base is ~3x faster than -large on CPU. Disable with false.
RERANKER_MODEL=BAAI/bge-reranker-base
ENABLE_RERANKER=true

# Comma separated list of allowed frontend origins (use * only for local dev)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Scanned PDFs: requires Tesseract installed on the machine
ENABLE_OCR=false
